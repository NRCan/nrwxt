{
    "name": "nrcan/nrwxt",
    "description": "Project template for Drupal 11 sites built with the WxT distribution.",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "aws/aws-sdk-php": "^3.369",
        "composer/installers": "^2.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/access_unpublished": "^1.9",
        "drupal/antibot": "^2.0",
        "drupal/backup_migrate": "^5.1",
        "drupal/bg_image_formatter": "^1.18",
        "drupal/ckeditor5_fullscreen": "^1.0",
        "drupal/ckeditor5_paste_filter": "^1.1",
        "drupal/ckeditor5_plugin_pack": "^1.5",
        "drupal/ckeditor_codemirror": "^3.1",
        "drupal/cloudfront_cache_path_invalidate": "^4.1",
        "drupal/conflict": "^3.0@beta",
        "drupal/core-composer-scaffold": "11.3.*",
        "drupal/devel": "^5.5",
        "drupal/edit_uuid": "^3.0",
        "drupal/externalauth": "^2.0",
        "drupal/fancy_file_delete": "^2.0",
        "drupal/field_group": "^4.0",
        "drupal/file_delete": "^3.0",
        "drupal/flexible_permissions": "^2.0",
        "drupal/google_analytics": "^4.0",
        "drupal/google_tag": "^2.0",
        "drupal/header_and_footer_scripts": "^3.0",
        "drupal/honeypot": "^2.2",
        "drupal/jsonapi_views": "^1.1",
        "drupal/key": "^1.22",
        "drupal/language_selection_page": "^3.0",
        "drupal/mailsystem": "^4.5",
        "drupal/media_entity_download": "^2.4",
        "drupal/media_pdf_thumbnail": "^7.0",
        "drupal/memcache": "^2.7",
        "drupal/mimemail": "^2.0",
        "drupal/moderated_content_bulk_publish": "^2.0",
        "drupal/moderation_dashboard": "^3.1",
        "drupal/moderation_sidebar": "^1.8",
        "drupal/o365": "^6.0@beta",
        "drupal/openid_connect_windows_aad": "^2.0@beta",
        "drupal/phpmailer_smtp": "^2.4",
        "drupal/protected_pages": "^1.9",
        "drupal/purge": "^3.6",
        "drupal/quickedit": "^2.0",
        "drupal/rdf": "^3.0@beta",
        "drupal/recaptcha": "^3.4",
        "drupal/recaptcha_element": "^1.1",
        "drupal/schema_metatag": "^3.0",
        "drupal/schemata": "^1.0",
        "drupal/shs": "^2.0",
        "drupal/simple_gmap": "^4.0",
        "drupal/simplei": "^3.0",
        "drupal/single_content_sync": "^1.4",
        "drupal/smtp": "^1.0@dev",
        "drupal/stage_file_proxy": "^4.0",
        "drupal/statistics": "^1.0",
        "drupal/toc_filter": "^2.4",
        "drupal/token_or": "^2.3",
        "drupal/tome": "^1.14",
        "drupal/toolbar_language_switcher": "^2.0",
        "drupal/variationcache": "^1.0@dev",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_entity_embed": "^2.0@dev",
        "drupalwxt/wxt": "6.3.0",
        "lcobucci/clock": "^3.5"
    },
    "require-dev": {
        "drupal/core-dev": "11.1.9",
        "drupal/drupal": "^11.1",
        "drupal/drupal-extension": "5.0.0-alpha1",
        "drush/drush": "^13.3.3",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "phpspec/prophecy-phpunit": "^2",
        "squizlabs/php_codesniffer": "3.*",
        "vlucas/phpdotenv": "^5.1",
        "webflo/drupal-finder": "^1.2"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "discard-changes": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-vendor-hardening": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "package",
            "package": {
                "name": "fontawesome/fontawesome",
                "version": "6.4.2",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "fontawesome"
                },
                "dist": {
                    "url": "https://use.fontawesome.com/releases/v6.4.2/fontawesome-free-6.4.2-web.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "scripts": {
        "post-install-cmd": [
            "@copy-composer-directory"
        ],
        "post-update-cmd": [
            "@copy-composer-directory"
        ],
        "copy-composer-directory": [
            "[ -d vendor/drupal/drupal/composer ] && mkdir -p html/composer && cp -R vendor/drupal/drupal/composer/* html/composer/ || echo 'composer directory not found; skipping copy'"
        ],
        "post-create-project-cmd": "rm -r -f behat.yml",
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}": [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/group": {
                "3401829 - Remove dependency on flexible permissions": "https://www.drupal.org/files/issues/2023-12-20/fixing-flexible-permissions-error-3401829.patch"
            },
            "drupal/layout_builder_st": {
                "3069964 - Type error": "https://www.drupal.org/files/issues/2026-01-09/layout_builder_st-3069964-49.patch"
            },
            "drupal/page_manager": {
                "3438993 - Some mandatory parameters are missing for route entity.page.devel_load": "https://www.drupal.org/files/issues/2024-08-14/page-manager-3438993-MR34-24.patch"
            },
            "drupal/views_entity_embed": {
                "3472733 - Embed button no using SVG": "https://www.drupal.org/files/issues/2025-12-10/views_entity_embed-.patch-3472733-3.patch"
            },
            "drupalwxt/wxt": {
                "3619082 - Assertion error on node view": "https://git.drupalcode.org/project/wxt/-/merge_requests/38.diff"
            }
        },
        "patches-ignore": {
            "drupalwxt/wxt": {
                "drupal/panels": {
                    "Enter drupal/panels patch #3577740 description here": "https://www.drupal.org/files/issues/2026-03-07/panels-php8-4-deprecations-3577740-2.patch"
                },
                "drupal/page_manager": {
                    "Enter drupal/page_manager patch #3536704 description here": "https://www.drupal.org/files/issues/2026-03-07/page_manager-php8-4-deprecation-3536704-15.patch"
                },
                "drupal/ckeditor_details": {
                    "3244311 - Allow <details> element to be placed without <div>": "https://www.drupal.org/files/issues/2024-11-15/3244311-9.patch"
                }
            } 
        }
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
