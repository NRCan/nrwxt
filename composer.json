{
    "name": "nrcan/nrwxt",
    "description": "NRCan deployment template based on the WxT Deployment of Drupal",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "aws/aws-sdk-php": "^3.369",
        "composer/installers": "^2.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/access_unpublished": "^1.9",
        "drupal/antibot": "^2.0",
        "drupal/backup_migrate": "^5.1",
        "drupal/bg_image_formatter": "^1.18",
        "drupal/ckeditor5_fullscreen": "^1.0",
        "drupal/cloudfront_cache_path_invalidate": "^4.1",
        "drupal/conflict": "^3.0@beta",
        "drupal/devel": "^5.4",
        "drupal/edit_uuid": "^3.0",
        "drupal/externalauth": "^2.0",
        "drupal/fancy_file_delete": "^2.0",
        "drupal/field_group": "^3.6",
        "drupal/file_delete": "^3.0",
        "drupal/flexible_permissions": "^2.0",
        "drupal/google_analytics": "^4.0",
        "drupal/google_tag": "^2.0",
        "drupal/header_and_footer_scripts": "^3.0",
        "drupal/honeypot": "2.1.4",
        "drupal/jsonapi_views": "^1.1",
        "drupal/key": "^1.22",
        "drupal/language_selection_page": "^3.0",
        "drupal/mailsystem": "^4.5",
        "drupal/media_entity_download": "^2.4",
        "drupal/media_pdf_thumbnail": "^7.0",
        "drupal/memcache": "^2.7",
        "drupal/migrate_source_html": "^1.0",
        "drupal/mimemail": "^2.0",
        "drupal/moderated_content_bulk_publish": "^2.0",
        "drupal/moderation_dashboard": "^3.1",
        "drupal/moderation_sidebar": "^1.8",
        "drupal/o365": "^5.0",
        "drupal/openid_connect_windows_aad": "^2.0@beta",
        "drupal/phpmailer_smtp": "^2.3",
        "drupal/protected_pages": "^1.9",
        "drupal/public_preview": "^1.0",
        "drupal/purge": "^3.6",
        "drupal/quickedit": "^2.0",
        "drupal/rdf": "^2.1",
        "drupal/recaptcha": "^3.4",
        "drupal/recaptcha_element": "^1.1",
        "drupal/schema_metatag": "^3.0",
        "drupal/schemata": "^1.0",
        "drupal/shs": "^2.0",
        "drupal/simple_gmap": "^4.0",
        "drupal/simplei": "^3.0",
        "drupal/single_content_sync": "^1.4",
        "drupal/smtp": "^1.4",
        "drupal/toc_filter": "^2.4",
        "drupal/token_or": "^2.3",
        "drupal/tome": "^1.14",
        "drupal/toolbar_language_switcher": "^2.0",
        "drupal/transliterate_filenames": "^2.0",
        "drupal/variationcache": "^1.5",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_entity_embed": "^2.0",
        "drupalwxt/wxt": "5.6.1",
        "lcobucci/clock": "^3.5",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "drupal/coder": "^8.3",
        "drupal/core-dev": "^10.2",
        "drupal/drupal-extension": "5.0.0-alpha1",
        "drush/drush": "^12.4.3",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "phpspec/prophecy-phpunit": "^2",
        "squizlabs/php_codesniffer": "3.*",
        "vlucas/phpdotenv": "^5.1",
        "webflo/drupal-finder": "^1.2"
    },
    "config": {
        "discard-changes": true,
        "sort-packages": true,
        "secure-http": false,
        "prestissimo": {
            "maxConnections": 10,
            "minConnections": 5
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        }
    ],
    "scripts": {
        "post-create-project-cmd": "rm -r -f behat.yml",
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}": [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": false,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/group": {
                "3401829 - Remove dependency on flexible permissions": "https://www.drupal.org/files/issues/2023-12-20/fixing-flexible-permissions-error-3401829.patch"
            }
         },
        "patches-ignore": { },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/webform/composer.libraries.json"
            ]
        }
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
